{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticus-dumper.local/schema/progression-model.schema.json",
  "title": "Tacticus Progression Cost Model",
  "allOf": [
    {"$ref": "https://tacticus-dumper.local/schema/common.schema.json#/$defs/knowledge_document"},
    {
      "type": "object",
      "required": ["action_type"],
      "properties": {
        "action_type": {"enum": ["ability_level", "unit_progression", "unlock", "rank"]},
        "level_bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["rarity", "first_target_level", "coin_costs", "badge_costs"],
            "properties": {
              "rarity": {"enum": ["Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic"]},
              "first_target_level": {"type": "integer", "minimum": 2},
              "coin_costs": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "integer", "minimum": 0}
              },
              "badge_costs": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "integer", "minimum": 0}
              }
            },
            "additionalProperties": false
          }
        },
        "max_progression_index": {"type": "integer", "minimum": 1},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "current_progression_index",
              "target_progression_index",
              "target_label",
              "action_type",
              "shard_resource",
              "shard_amount"
            ],
            "properties": {
              "current_progression_index": {"type": "integer", "minimum": 0},
              "target_progression_index": {"type": "integer", "minimum": 1},
              "target_label": {"type": "string", "minLength": 1},
              "action_type": {"enum": ["promotion", "ascension"]},
              "shard_resource": {"enum": ["shards", "mythic_shards"]},
              "shard_amount": {"type": "integer", "minimum": 1},
              "orb": {
                "type": "object",
                "required": ["rarity", "amount"],
                "properties": {
                  "rarity": {"enum": ["Uncommon", "Rare", "Epic", "Legendary", "Mythic"]},
                  "amount": {"type": "integer", "minimum": 1}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "unlock_costs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["base_rarity", "target_progression_index", "shards"],
            "properties": {
              "base_rarity": {"enum": ["Common", "Uncommon", "Rare", "Epic", "Legendary"]},
              "target_progression_index": {"type": "integer", "minimum": 0},
              "shards": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "rank_labels": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_upgrade_slots": {
          "type": "integer",
          "minimum": 1
        }
      },
      "oneOf": [
        {
          "properties": {"action_type": {"const": "ability_level"}},
          "required": ["level_bands"],
          "not": {"required": ["steps"]}
        },
        {
          "properties": {"action_type": {"const": "unit_progression"}},
          "required": ["max_progression_index", "steps"],
          "not": {"required": ["level_bands"]}
        },
        {
          "properties": {"action_type": {"const": "unlock"}},
          "required": ["unlock_costs"],
          "not": {"anyOf": [{"required": ["level_bands"]}, {"required": ["steps"]}]}
        },
        {
          "properties": {"action_type": {"const": "rank"}},
          "required": ["rank_labels", "required_upgrade_slots"],
          "not": {
            "anyOf": [
              {"required": ["level_bands"]},
              {"required": ["steps"]},
              {"required": ["unlock_costs"]}
            ]
          }
        }
      ]
    }
  ],
  "unevaluatedProperties": false
}
