{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticus-dumper.local/schema/character.schema.json",
  "title": "Tacticus Character Knowledge",
  "allOf": [
    {"$ref": "https://tacticus-dumper.local/schema/common.schema.json#/$defs/knowledge_document"},
    {
      "type": "object",
      "required": ["faction_id", "alliance_id", "base_rarity"],
      "properties": {
        "faction_id": {"type": "string", "minLength": 1},
        "alliance_id": {"enum": ["Imperial", "Chaos", "Xenos"]},
        "base_rarity": {"enum": ["Common", "Uncommon", "Rare", "Epic", "Legendary"]},
        "abilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "traits": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "mode_evaluations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mode", "value", "confidence", "evidence"],
            "properties": {
              "mode": {"type": "string", "minLength": 1},
              "value": {"type": "number", "minimum": 0, "maximum": 10},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "conditions": {"type": "array", "items": {"type": "string"}},
              "evidence": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "breakpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target_type", "target_value", "reason", "confidence"],
            "properties": {
              "target_type": {"type": "string", "minLength": 1},
              "target_value": {},
              "reason": {"type": "string", "minLength": 1},
              "modes": {"type": "array", "items": {"type": "string"}},
              "conditions": {"type": "array", "items": {"type": "string"}},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
