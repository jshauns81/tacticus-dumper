{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticus-dumper.local/schema/effect.schema.json",
  "title": "Tacticus Effect Knowledge",
  "allOf": [
    {"$ref": "https://tacticus-dumper.local/schema/common.schema.json#/$defs/knowledge_document"},
    {
      "type": "object",
      "required": ["effect_type", "scope"],
      "properties": {
        "effect_type": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "duration": {"type": "string", "minLength": 1},
        "stacking_rule": {"type": "string", "minLength": 1},
        "producer_ability_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "beneficiary_character_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "beneficiary_roles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
