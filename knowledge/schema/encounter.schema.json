{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacticus-dumper.local/schema/encounter.schema.json",
  "title": "Tacticus Encounter Knowledge",
  "allOf": [
    {"$ref": "https://tacticus-dumper.local/schema/common.schema.json#/$defs/knowledge_document"},
    {
      "type": "object",
      "required": ["mode_id", "effective_game_version", "phases"],
      "properties": {
        "mode_id": {"type": "string", "minLength": 1},
        "effective_game_version": {"type": "string", "minLength": 1},
        "restrictions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "mechanics"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "mechanics": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          }
        },
        "counter_effect_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "scoring_considerations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
