# Host port exposed on the Unraid/Docker host.
APP_PORT=5001

# Unraid appdata path that must persist across container recreation.
APPDATA_DIR=/mnt/user/appdata/tacticus-dumper

# Container timezone.
TZ=America/Chicago

# Optional: enable Flask basic auth by setting both values.
AUTH_USER=
AUTH_PASS=

# Optional: pre-seed your Tacticus API key instead of saving it in the UI.
TACTICUS_KEY=

# Optional Gunicorn tuning.
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# Optional for local compose builds; Dockhand/GHCR users can leave this unset.
GITHUB_REPOSITORY=your-github-user/tacticus-dumper
